{
  "name": "dsh-agent-hardware-sensors",
  "version": "0.1.0",
  "description": "DSH 硬件传感器插件：自动探测本机 AIDA64 / HWiNFO 的传感器导出，谁开着读谁（两者都不要求开启）；提供 hw_sensors 工具与可拖动的常驻读数挂件",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "hardware",
    "sensors",
    "temperature",
    "aida64",
    "hwinfo",
    "windows"
  ],
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "assets",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.2.2-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:browser": "node test/realbrowser.test.mjs"
  }
}
